<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Hf5_Device.ToDoPage"
             Title="Yapılacaklar">

    <CollectionView x:Name="Listem" ItemsSource="{Binding ToDoList}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border>
                    <VerticalStackLayout Spacing="10" Margin="10">
                        <Label  Text="{Binding Title}" FontSize="20" />
                        <Label  Text="{Binding Details}" FontSize="16" />

                        <HorizontalStackLayout Spacing="20">
                            <Label VerticalOptions="Center"
                                Text="{Binding DueDate, StringFormat='Due: {0:dd/MM/yyyy}'}" FontSize="14" />
                            <CheckBox IsChecked="{Binding IsCompleted}" />
                            <Label Text="{Binding Durum}" 
                                   VerticalOptions="Center" Margin="-25,0" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                         
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    
</ContentPage>