<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Hf5_Device.MainPage"
             Loaded="ContentPage_Loaded">

    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="MaterialBaslik">
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="TextColor" Value="Orange"/>
        </Style>
        <Style TargetType="Label" x:Key="FluentBaslik">
            <Setter Property="Background" Value="White"/>
            <Setter Property="TextColor" Value="Purple"/>
        </Style>
        <Style TargetType="Label" x:Key="AppleBaslik">
            <Setter Property="Background" Value="Gainsboro"/>
            <Setter Property="TextColor" Value="Fuchsia"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,0"  >
            <Label Text="Hoş geldiniz">
                <Label.FontSize>
                    <OnIdiom x:TypeArguments="x:Double" Phone="20" Tablet="26" Desktop="50" />
                </Label.FontSize>

                <!-- Değer bir nesne/stil olabilir -->
                <Label.Style>
                    <OnPlatform x:TypeArguments="Style">
                        <On Platform="Android" Value="{StaticResource MaterialBaslik}" />
                        <On Platform="WinUI"   Value="{StaticResource FluentBaslik}" />
                        <On Platform="iOS, MacCatalyst"  Value="{StaticResource AppleBaslik}" />
                    </OnPlatform>
                </Label.Style>
            </Label>

            <Border >

                <Grid ColumnDefinitions="Auto,*"  ColumnSpacing="10"
                  RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

                    <Label Text="Platform:" Grid.Row="0"/>
                    <Label x:Name="PlatformLabel" Text="Unknown" Grid.Column="1" />

                    <Label Text="Versiyon:" Grid.Row="1"/>
                    <Label x:Name="VersionLabel" Text="Unknown" Grid.Row="1" Grid.Column="1" />

                    <Label Text="Tip:" Grid.Row="2"/>
                    <Label x:Name="PhysicalTypeLabel" Text="Unknown" Grid.Row="2" Grid.Column="1" />

                    <Label Text="Cihaz Türü:" Grid.Row="3" />
                    <Label x:Name="DeviceTypeLabel" Text="Unknown" Grid.Row="3" Grid.Column="1"  />
                    
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBoxTapped" NumberOfTapsRequired="1" />
                </Border.GestureRecognizers>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
