<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Hf6_Stiller.MainPage">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="BackgroundColor" Value="Orange" />
            <Setter Property="FontSize" Value="25"/>
        </Style>


    </ContentPage.Resources>

    <ScrollView>

        <VerticalStackLayout Spacing="12" Padding="24">

            <Label Text="Ad Soyad" />
            <Entry Placeholder="Adınızı ve soyadınızı giriniz" />

            <Label Text="Telefon" />
            <Entry Placeholder="Telefon numarasını giriniz" Keyboard="Telephone" />

            <Label Text="E-posta" />
            <Entry Placeholder="E-posta adresini giriniz" Keyboard="Email" />

            <HorizontalStackLayout>
                <Button Style="{StaticResource OkButtonStyle}" />
                <Button Style="{StaticResource CancelButtonStyle}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
