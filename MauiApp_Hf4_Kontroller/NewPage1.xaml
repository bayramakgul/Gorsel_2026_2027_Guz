<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Hf4_Kontroller.NewPage1"
             Title="NewPage1">
    <ScrollView>

        <VerticalStackLayout>
            <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <Button Text="Start" 
                Background="Green" 
                HorizontalOptions="Start"
                WidthRequest="200"/>
            <Button Text="Center"  
                BackgroundColor="Yellow" 
                HorizontalOptions="Center"
                WidthRequest="200"/>
            <Button Text="End"  
                Background="Blue" 
                HorizontalOptions="End"
                WidthRequest="200"/>
            <Button Text="Fill"  
                Background="Red"  
                HorizontalOptions="Fill"
                />

            <Image 
            WidthRequest="150"
            Aspect="Fill"
            Source="https://cdn03.ciceksepeti.com/cicek/grat125-1/L/somon-lila-buket-kagidinda-saksi-lilyum-grat125-bbb65fc1-3bce-4404-a34b-33314db96af7.png"/>

            <Entry MinimumWidthRequest="250" 
               MaximumWidthRequest="400"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>