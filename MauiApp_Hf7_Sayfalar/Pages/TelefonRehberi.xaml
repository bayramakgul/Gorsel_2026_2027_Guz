<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_Hf7_Sayfalar.Pages.TelefonRehberi"
             Title="TelefonRehberi">
    <CollectionView ItemsSource="{Binding Kisiler}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView>
                    <SwipeView.LeftItems>
                        <SwipeItem  Text="📝" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                             Path=BindingContext.EditCommand}"
                                    CommandParameter="{Binding .}"/>
                        <SwipeItem  Text="⭐" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                             Path=BindingContext.FavoriCommand}"
                                    CommandParameter="{Binding .}"/>
                    </SwipeView.LeftItems>
                    <SwipeView.RightItems>
                        <SwipeItem  Text="🗑️" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                             Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding .}"/>
                    </SwipeView.RightItems>
                    <Border>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5"
                      ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <Image Source="{Binding UserImage}"
                           WidthRequest="50" Grid.RowSpan="3" />

                        <Label Text="{Binding FullName}" Grid.Column="1" />
                        <Label Text="{Binding Phone}"    Grid.Column="1" Grid.Row="1"/>
                        <Label Text="{Binding Email}"    Grid.Column="1" Grid.Row="2"/>
                    </Grid>
                </Border>
                </SwipeView>

            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>